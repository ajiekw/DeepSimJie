[Unit]
Description=Static HTTP Server on 8080
After=network.target

[Service]
# Set this to the directory that contains eda_dl_studio.html
WorkingDirectory=/home/ubuntu/DeepSimJie
ExecStart=/usr/bin/python3 -m http.server 8080 --bind 0.0.0.0
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
